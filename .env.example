# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your actual
# configuration. Never commit the .env file to version control.
#
# To use: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# SESSION CONFIGURATION
# ------------------------------------------------------------------------------
# Secret key for session encryption and signing
# Generate a strong random string (e.g., using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# ------------------------------------------------------------------------------
# ADMIN CONFIGURATION
# ------------------------------------------------------------------------------
# JSON array of user IDs that should have admin privileges
# Example: ["1","2","3"] for users with IDs 1, 2, and 3
ADMIN_IDS=["1"]

# ------------------------------------------------------------------------------
# EMAIL/SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# SMTP server settings for sending emails (e.g., password reset, guest inquiries)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password

# ------------------------------------------------------------------------------
# DIGITALOCEAN SPACES CONFIGURATION
# ------------------------------------------------------------------------------
# DigitalOcean Spaces credentials for file storage (player images, etc.)
# Get these from your DigitalOcean Spaces settings
SPACES_ACCESS_KEY=your-spaces-access-key
SPACES_SECRET_KEY=your-spaces-secret-key
SPACES_BUCKET=your-bucket-name

# ------------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Environment setting - affects cookie security and other production settings
# Use 'development' for local development, 'production' for deployed instances
NODE_ENV=development

# Application port (optional - defaults to 3000 if not specified)
PORT=3000
