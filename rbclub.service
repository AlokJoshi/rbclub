[Unit]
Description=RBClub Bridge Club Management System
Documentation=https://github.com/AlokJoshi/rbclub
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/rbclub
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rbclub

# Environment
Environment=NODE_ENV=production

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
